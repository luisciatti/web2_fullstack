{
    "info": {
        "name": "web2_fullstack - Back-end APIs",
        "description": "Collection para validar as APIs REST do backend com criação, consulta, atualização, geração e remoção de projetos.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Projetos",
            "description": "Run order sugerida: 1) Health check, 2) Criar projeto, 3) Listar projetos, 4) Buscar projeto por ID, 5) Atualizar projeto, 6) Gerar artefatos, 7) Listar artefatos, 8) Diagrama UML, 9) Diagrama Cloud, 10) Excluir projeto.",
            "item": [
                {
                    "name": "01 - Health check",
                    "request": {
                        "method": "GET",
                        "description": "Verifica se o backend esta respondendo antes de executar os demais requests.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/actuator/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "actuator",
                                "health"
                            ]
                        }
                    }
                },
                {
                    "name": "03 - Listar projetos",
                    "request": {
                        "method": "GET",
                        "description": "Lista todos os projetos cadastrados. Pode ser usado antes e depois do POST para conferir os dados persistidos.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos"
                            ]
                        }
                    }
                },
                {
                    "name": "02 - Criar projeto",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const response = pm.response.json();",
                                    "if (response.id) {",
                                    "  pm.collectionVariables.set('id', response.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "description": "Cria um projeto e salva automaticamente o campo id retornado na variavel de collection {{id}}.",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"id\": \"\",\n  \"nome\": \"string\",\n  \"linguagem\": \"string\",\n  \"framework\": \"string\",\n  \"provedorCloud\": \"string\",\n  \"classes\": [\n    {\n      \"nome\": \"string\",\n      \"atributos\": [\n        {\n          \"nome\": \"string\",\n          \"tipo\": \"string\",\n          \"name\": \"string\"\n        }\n      ],\n      \"metodos\": [\n        {\n          \"nome\": \"string\",\n          \"tipoRetorno\": \"string\",\n          \"name\": \"string\"\n        }\n      ],\n      \"name\": \"string\"\n    }\n  ],\n  \"relacoes\": [\n    {\n      \"origem\": \"string\",\n      \"destino\": \"string\",\n      \"tipo\": \"string\"\n    }\n  ],\n  \"servicosCloud\": [\n    {\n      \"id\": \"string\",\n      \"tipo\": \"string\",\n      \"categoria\": \"string\",\n      \"configuracao\": {\n        \"additionalProp1\": \"string\",\n        \"additionalProp2\": \"string\",\n        \"additionalProp3\": \"string\"\n      }\n    }\n  ],\n  \"conexoesCloud\": [\n    {\n      \"de\": \"string\",\n      \"para\": \"string\",\n      \"rotulo\": \"string\"\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos"
                            ]
                        }
                    }
                },
                {
                    "name": "04 - Buscar projeto por ID",
                    "request": {
                        "method": "GET",
                        "description": "Busca o projeto usando a variavel {{id}} preenchida no request de criacao.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "05 - Atualizar projeto",
                    "request": {
                        "method": "PUT",
                        "description": "Atualiza o projeto identificado por {{id}} com o JSON enviado no body.",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"id\": \"{{id}}\",\n  \"nome\": \"string\",\n  \"linguagem\": \"string\",\n  \"framework\": \"string\",\n  \"provedorCloud\": \"string\",\n  \"classes\": [\n    {\n      \"nome\": \"string\",\n      \"atributos\": [\n        {\n          \"nome\": \"string\",\n          \"tipo\": \"string\",\n          \"name\": \"string\"\n        }\n      ],\n      \"metodos\": [\n        {\n          \"nome\": \"string\",\n          \"tipoRetorno\": \"string\",\n          \"name\": \"string\"\n        }\n      ],\n      \"name\": \"string\"\n    }\n  ],\n  \"relacoes\": [\n    {\n      \"origem\": \"string\",\n      \"destino\": \"string\",\n      \"tipo\": \"string\"\n    }\n  ],\n  \"servicosCloud\": [\n    {\n      \"id\": \"string\",\n      \"tipo\": \"string\",\n      \"categoria\": \"string\",\n      \"configuracao\": {\n        \"additionalProp1\": \"string\",\n        \"additionalProp2\": \"string\",\n        \"additionalProp3\": \"string\"\n      }\n    }\n  ],\n  \"conexoesCloud\": [\n    {\n      \"de\": \"string\",\n      \"para\": \"string\",\n      \"rotulo\": \"string\"\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "06 - Gerar artefatos",
                    "request": {
                        "method": "POST",
                        "description": "Executa a geracao de artefatos com base no projeto salvo em {{id}}.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/gerar",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "gerar"
                            ]
                        }
                    }
                },
                {
                    "name": "07 - Listar artefatos",
                    "request": {
                        "method": "GET",
                        "description": "Retorna os artefatos gerados para o projeto informado em {{id}}.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/artefatos",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "artefatos"
                            ]
                        }
                    }
                },
                {
                    "name": "08 - Diagrama UML",
                    "request": {
                        "method": "GET",
                        "description": "Retorna o diagrama UML em formato textual para o projeto informado em {{id}}.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/diagrama/uml",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "diagrama",
                                "uml"
                            ]
                        }
                    }
                },
                {
                    "name": "09 - Diagrama Cloud",
                    "request": {
                        "method": "GET",
                        "description": "Retorna o diagrama cloud em formato textual para o projeto informado em {{id}}.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/diagrama/cloud",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "diagrama",
                                "cloud"
                            ]
                        }
                    }
                },
                {
                    "name": "10 - Excluir projeto",
                    "request": {
                        "method": "DELETE",
                        "description": "Remove o projeto identificado por {{id}}. Rode por ultimo para nao perder o recurso antes dos demais testes.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "description": "Endereco base do backend. Exemplo: http://localhost:8080"
        },
        {
            "key": "id",
            "value": "",
            "description": "Id do projeto criado no POST. A collection preenche essa variavel automaticamente depois de executar '02 - Criar projeto'."
        }
    ]
}