{
    "info": {
        "name": "web2_fullstack - Back-end APIs",
        "description": "Collection para validar as APIs REST do backend com criação, consulta, atualização, geração e remoção de projetos.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Projetos",
            "item": [
                {
                    "name": "Health check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/actuator/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "actuator",
                                "health"
                            ]
                        }
                    }
                },
                {
                    "name": "Listar projetos",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos"
                            ]
                        }
                    }
                },
                {
                    "name": "Criar projeto",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const response = pm.response.json();",
                                    "if (response.id) {",
                                    "  pm.collectionVariables.set('id', response.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nome\": \"Projeto Exemplo\",\n  \"linguagem\": \"java\",\n  \"framework\": \"spring-boot\",\n  \"provedorCloud\": \"aws\",\n  \"classes\": [\n    {\n      \"nome\": \"Usuario\",\n      \"atributos\": [\n        {\n          \"nome\": \"nome\",\n          \"tipo\": \"String\"\n        }\n      ],\n      \"metodos\": []\n    }\n  ],\n  \"servicosCloud\": [\n    {\n      \"id\": \"db-principal\",\n      \"tipo\": \"aws-rds\",\n      \"categoria\": \"DATA\",\n      \"configuracao\": {\n        \"engine\": \"postgres\",\n        \"dbName\": \"projeto_exemplo\",\n        \"username\": \"usuario_teste\",\n        \"password\": \"senha_teste\"\n      }\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos"
                            ]
                        }
                    }
                },
                {
                    "name": "Buscar projeto por ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Atualizar projeto",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nome\": \"Projeto Atualizado\",\n  \"linguagem\": \"java\",\n  \"framework\": \"spring-boot\",\n  \"provedorCloud\": \"aws\",\n  \"classes\": [\n    {\n      \"nome\": \"Usuario\",\n      \"atributos\": [\n        {\n          \"nome\": \"nome\",\n          \"tipo\": \"String\"\n        }\n      ],\n      \"metodos\": []\n    }\n  ],\n  \"servicosCloud\": [\n    {\n      \"id\": \"db-principal\",\n      \"tipo\": \"aws-rds\",\n      \"categoria\": \"DATA\",\n      \"configuracao\": {\n        \"engine\": \"postgres\",\n        \"dbName\": \"projeto_exemplo\",\n        \"username\": \"usuario_teste\",\n        \"password\": \"senha_teste\"\n      }\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Gerar artefatos",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/gerar",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "gerar"
                            ]
                        }
                    }
                },
                {
                    "name": "Listar artefatos",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/artefatos",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "artefatos"
                            ]
                        }
                    }
                },
                {
                    "name": "Diagrama UML",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/diagrama/uml",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "diagrama",
                                "uml"
                            ]
                        }
                    }
                },
                {
                    "name": "Diagrama Cloud",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}/diagrama/cloud",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}",
                                "diagrama",
                                "cloud"
                            ]
                        }
                    }
                },
                {
                    "name": "Excluir projeto",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projetos/{{id}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projetos",
                                "{{id}}"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080"
        },
        {
            "key": "id",
            "value": ""
        }
    ]
}